          "level": "warning",
          "message": {
            "text": "Grant dedup compares case-sensitive canonical host targets while DNS identity is case-insensitive (config path lowercases, wire path does not)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/gatekeeper/src/server.rs",
                  "uriBaseId": "%SRCROOT%"

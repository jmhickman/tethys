        },
        {
          "ruleId": "result-discarded",
          "level": "warning",
          "message": {
            "text": "SetDst UPDATE error swallowed by `.unwrap_or(0)` \u2014 DB failure conflated with \"row not approved\", resolution silently unpersisted"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/gatekeeper/src/ledger.rs",

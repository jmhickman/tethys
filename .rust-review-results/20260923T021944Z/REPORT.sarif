            ]
          }
        },
        {
          "ruleId": "result-discarded",
          "level": "warning",
          "message": {
            "text": "Audit-log INSERT error silently discarded \u2014 security-relevant audit records can vanish without a trace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/gatekeeper/src/ledger.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 347

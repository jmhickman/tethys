[Unit]
Description=gatekeeper MCP server (connection %i)
# One instance per accepted connection (Accept=yes on gk-mcp.socket): systemd
# connects the client stream to this process's stdio (see StandardInput=
# below — stdin is NOT automatic), so gk-mcp stays a plain stdio MCP server
# with no socket-handling code of its own.

[Service]
Type=simple
ExecStart=/usr/local/bin/gk-mcp --gatekeeper-socket /run/gatekeeper/mcp.sock
# Accept=yes gives the accepted connection on stdout automatically, but
# stdin defaults to /dev/null — without StandardInput=socket, gk-mcp reads
# EOF and dies with "connection closed: initialize request" (verified on
# systemd 259). StandardOutput=socket is already the default here; stated
# for intent. StandardError must NOT inherit (it follows stdout by default):
# gk-mcp logs to stderr, and those lines would land inside the MCP
# JSON-RPC stream — keep them in the journal.
StandardInput=socket
StandardOutput=socket
StandardError=journal
# The account whose uid the gatekeeper expects on mcp.sock (its mcp_user
# config knob must name this user, or a deliberate substitute).
User=gk-mcp-service
Group=gk-mcp-service
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

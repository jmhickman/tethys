#!/usr/sbin/nft -f
# Tethys static egress baseline — applied at boot by
# tethys-baseline.service, before tethysd.service starts.
#
# Ownership contract: tethysd NEVER edits rules or verdicts in this
# layer. It adds/removes ELEMENTS inside grants_v4/grants_v6 (expiry comes
# from each element's kernel timeout; no cron/poller deletes them), and it
# OWNS the CONTENTS of carve_v4/carve_v6 wholesale: those sets are flushed
# and reinstalled from the config `allow` list on every daemon start. To
# change always-allowed egress, edit /etc/tethys/config.toml (`allow`)
# and restart tethysd — do NOT `nft add element` into carve_* by hand;
# it will be wiped on the next restart.
# This file pre-creates all four sets EMPTY so the lookup rules below parse;
# the grant set definitions MUST stay byte-compatible with tethys_core::nft
# ensure_base() (crates/core/src/nft.rs) or tethysd startup fails.
#
# Grammar is the verified nft 1.1.6 form: set keys are
# `ip daddr . meta l4proto . th dport` and rule concats match that key order
# exactly; no `counter` flag on sets — named counter objects only.
#
# RELOAD CONTRACT: do not reload this file while grants are
# live (`add set` on an existing set aborts). Change sequence:
#   systemctl stop tethysd \
#     && nft delete table inet tethys || true \
#     && nft -f /etc/tethys/baseline.nft \
#     && systemctl start tethysd
# Escape hatch if the egress policy ever locks you out: LXC console from #
# Proxmox host (never network-dependent), then `nft delete table inet tethys`.

table inet tethys {
    # ---- operator-declared always-allowed tuples -----------------------
    # CONTENTS owned by tethysd at runtime: flushed + reinstalled from
    # config `allow` on every start. Same key grammar as the grant sets so
    # one rule shape serves both; no timeout — entries persist until #
    # next restart's reinstall.
    set carve_v4 {
        typeof ip daddr . meta l4proto . th dport
        flags interval
    }
    set carve_v6 {
        typeof ip6 daddr . meta l4proto . th dport
        flags interval
    }

    # ---- tethysd-owned element sets (created EMPTY here) ------------
    set grants_v4 {
        typeof ip daddr . meta l4proto . th dport
        flags interval,timeout
        timeout 86400s
    }
    set grants_v6 {
        typeof ip6 daddr . meta l4proto . th dport
        flags interval,timeout
        timeout 86400s
    }

    counter tethys_drops { }

    # Enforcement scope chain (UID scoping, R11): declared EMPTY here; #
    # tethysd owns its contents (flush + rebuild from agent_user at every
    # start). The `jump scope` in egress below is the ONLY way to exempt uids
    # before the drop: a separate hooked chain cannot do it (each base chain
    # on the same hook is an independent netfilter callback; accept in one
    # does NOT skip the others — probe-verified on nft 1.1.6). Inside scope,
    # policed uids RETURN (verdict falls through to the drop below) and
    # everyone else ACCEPTs (short-circuits egress, counted by tethys_exempt).
    chain scope { }

    # Accounting chains: declared EMPTY by the baseline, but their contents
    # are owned exclusively by tethysd (flush + rebuild from its ledger).
    # Rules here only ever carry named counters — no verdict can live in these
    # chains, so they cannot influence enforcement. Priority filter-10: they
    # observe every locally-generated packet BEFORE the egress verdict runs,
    # and the input chain catches established replies.
    chain acct_out {
        type filter hook output priority -10; policy accept;
    }
    chain acct_in {
        type filter hook input priority -10; policy accept;
    }

    chain egress {
        type filter hook output priority filter; policy drop;

        oifname "lo" accept
        ct state established,related accept

        # UID scoping: non-policed uids leave here (accept, counted tethys_exempt);
        # policed uids RETURN and continue down the policed path below.
        jump scope

        # Always-allowed base services: DHCP (v4 client/server, v6), DNS
        # (resolution is never blocked), ICMP + ICMPv6 to any host.
        meta l4proto udp th dport { 67, 68, 546, 547 } accept
        meta l4proto udp th dport 53 accept
        meta l4proto tcp th dport 53 accept
        meta l4proto icmp accept
        meta l4proto icmpv6 accept

        # human-populated essential services (dnf/mirrors live here)
        ip  daddr . meta l4proto . tcp dport @carve_v4 accept
        ip  daddr . meta l4proto . udp dport @carve_v4 accept
        ip6 daddr . meta l4proto . tcp dport @carve_v6 accept
        ip6 daddr . meta l4proto . udp dport @carve_v6 accept

        # model-approved grants (elements + kernel TTL owned by tethysd)
        ip  daddr . meta l4proto . tcp dport @grants_v4 accept
        ip  daddr . meta l4proto . udp dport @grants_v4 accept
        ip6 daddr . meta l4proto . tcp dport @grants_v6 accept
        ip6 daddr . meta l4proto . udp dport @grants_v6 accept

        # The emergency stop removes grants, never anything in this chain:
        # the baseline is the safe-by-default state and needs no off-switch.
        counter name tethys_drops limit rate 20/second log prefix "TETHYS-DROP: " drop
    }
}

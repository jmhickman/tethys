[Unit]
Description=Pentest scope enforcement gatekeeper (grant ledger + nft enforcer)
Requires=gatekeeper-baseline.service
After=gatekeeper-baseline.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gatekeeper --config /etc/gatekeeper/config.toml
Restart=on-failure
RestartSec=2s
# The account that owns the admin socket and holds the nft privileges. root is
# the default; any account with CAP_NET_ADMIN (see below) may be substituted,
# and the deployment tooling should make this configurable.
User=root
# Hardening: needs CAP_NET_ADMIN for `nft`, CAP_CHOWN to group-own mcp.sock;
# nothing else beyond sockets + db.
AmbientCapabilities=CAP_NET_ADMIN CAP_CHOWN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gatekeeper /run/gatekeeper
PrivateTmp=yes
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target

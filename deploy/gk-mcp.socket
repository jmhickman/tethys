# LEGACY (see deploy/README.md): socket-activated gk-mcp, for deployments
# where a dedicated service user runs gk-mcp per connection. The standard
# topology has the agent harness spawn gk-mcp as a stdio child instead —
# do not enable this socket in that case.
[Unit]
Description=gatekeeper MCP server socket
# gk-mcp is independent of the agent harness: the harness connects to this
# socket; systemd accepts and hands each connection to a gk-mcp@ instance.
# Ordered after gatekeeper.service so early connections find the daemon up
# (gk-mcp exits if it cannot reach mcp.sock; the client just reconnects).
Wants=gatekeeper.service
After=gatekeeper.service

[Socket]
ListenStream=/run/gatekeeper/mcp-server.sock
SocketMode=0660
# Who may connect is a deployment decision (typically the harness user or
# its group) — set at deploy time, e.g.:
#   SocketUser=hermes-agent
#   SocketGroup=hermes-agent
Accept=yes

[Install]
WantedBy=sockets.target

[Unit]
Description=Gatekeeper static egress baseline (default-deny + carve-outs)
# Baseline must exist before the gatekeeper installs grant elements into it.
Before=gatekeeper.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Reloading while grants are live aborts on `add set` EEXIST — see the
# RELOAD CONTRACT comment inside the ruleset file.
ExecStart=/usr/sbin/nft -f /etc/gatekeeper/baseline.nft

[Install]
WantedBy=multi-user.target
